# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/riego_iot_system"

# MQTT Broker Configuration
MQTT_BROKER_URL="mqtts://mqtt.riego.pipexapp.com:8883"
MQTT_USERNAME="esp32"
MQTT_PASSWORD="your_mqtt_password"
MQTT_MOISTURE_TOPIC="home/garden/moisture"
MQTT_PUMP_COMMAND_TOPIC="home/garden/pump/command"
MQTT_PUMP_STATUS_TOPIC="home/garden/pump/status"
MQTT_DEVICE_STATUS_TOPIC="home/garden/status"
MQTT_THRESHOLD_CONFIG_TOPIC="home/garden/config/threshold"

