// use prisma-8

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  password         String?
  name             String?
  role             String            @default("admin")
  devices          Device[]
  irrigationEvents IrrigationEvent[]
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()
}

model Device {
  id                   Int               @id @default(autoincrement())
  code                 String            @unique
  name                 String
  location             String?
  status               String            @default("ONLINE")
  minHumidityThreshold Float             @default(30.0)
  maxHumidityThreshold Float             @default(70.0)
  lastSeenAt           TimestamptzString?
  userId               Int?
  user                 User?             @relation(fields: [userId], references: [id])
  readings             HumidityReading[]
  irrigationEvents     IrrigationEvent[]
  createdAt            TimestamptzString @default(now())
  updatedAt            temporal.updatedAtString()
}

model HumidityReading {
  id          Int               @id @default(autoincrement())
  humidity    Float
  rawAdcValue Int?
  temperature Float?
  deviceId    Int?
  device      Device?           @relation(fields: [deviceId], references: [id])
  deviceCode  String?
  timestamp   TimestamptzString @default(now())
  createdAt   TimestamptzString @default(now())
}

model IrrigationEvent {
  id                 Int               @id @default(autoincrement())
  deviceId           Int?
  device             Device?           @relation(fields: [deviceId], references: [id])
  activatedAt        TimestamptzString @default(now())
  stoppedAt          TimestamptzString?
  durationSeconds    Int?
  mode               String            @default("AUTOMATIC")
  status             String            @default("COMPLETED")
  soilHumidityBefore Float?
  soilHumidityAfter  Float?
  userId             Int?
  user               User?             @relation(fields: [userId], references: [id])
  createdAt          TimestamptzString @default(now())
}
